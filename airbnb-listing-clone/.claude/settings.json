{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck)",
      "Bash(npm run format*)",
      "Bash(npm run test*)",
      "Bash(npm run parity*)"
    ],
    "deny": ["Bash(git push*)", "WebFetch(domain:airbnb-clone-umber-two.vercel.app)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format-file.mjs" }]
      }
    ]
  }
}
